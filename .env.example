# Copy to .env and fill in your values. All credentials stay local (.env is gitignored).

# MyEnergi hub credentials (from myaccount.myenergi.com → Products → hub → API key)
MYENERGI_HUB_SERIAL=10xxxxxx
MYENERGI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MYENERGI_LIBBI_SERIAL=2xxxxxxx

# myenergi account login — used to control charge-from-grid via the OAuth API
MYENERGI_APP_EMAIL=you@example.com
MYENERGI_APP_PASSWORD=yourpassword

# Battery capacity in kWh
LIBBI_CAPACITY_KWH=10.0

# Solcast rooftop site (solcast.com/rooftop-solar/dashboard)
SOLCAST_RESOURCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SOLCAST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Service settings
SERVICE_PORT=5000
SERVICE_TOKEN=changeme        # token for the /api/trigger-decision endpoint
SYNC_INTERVAL_HOURS=4
SAMPLE_INTERVAL_MINUTES=5    # live Libbi sampling (SOC, solar, grid, load, battery W)

# Always enable overnight grid charging if SOC at 23:00 is below this %,
# regardless of the solar forecast
MIN_SOC_PCT=40

# Safety switch — flip to false once you've verified the API works for your hub
DRY_RUN=true

# Property location (decimal degrees) — used for Open-Meteo weather forecasts
# that drive cold-weather battery pre-warm. Leave unset to disable.
WEATHER_LAT=
WEATHER_LON=

# Battery pre-warm
PREWARM_THRESHOLD_C=2.0       # 23:00 forecast flag only (dashboard ❄)
PREWARM_LEAD_MINUTES=120      # max lead the 00:10 planner may choose

# Tariff — 3-band model (defaults = Octopus Flux). Hours are integers and
# end-exclusive (2→5 covers 02:00-05:00). Windows must not wrap midnight,
# and off-peak must start 01:00 or later (pre-warm planning runs at 00:10).
TARIFF_OFFPEAK_START=2
TARIFF_OFFPEAK_END=5
TARIFF_PEAK_START=16
TARIFF_PEAK_END=19
TARIFF_OFFPEAK_P=18.0         # import price, pence/kWh
TARIFF_STANDARD_P=29.0
TARIFF_PEAK_P=36.0

# Libbi clock monitor — the hub stops recording Libbi history when the Libbi's
# clock drifts, so this checks the clock and history freshness and emails once
# on a problem and once on recovery. Without SMTP_HOST/ALERT_EMAIL_TO it only logs.
CLOCK_CHECK_INTERVAL_MINUTES=15
CLOCK_MAX_DRIFT_MINUTES=10
HISTORY_MAX_AGE_MINUTES=60
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                 # STARTTLS
SMTP_USER=you@gmail.com
SMTP_PASSWORD=                # Gmail: an app password (myaccount.google.com/apppasswords)
ALERT_EMAIL_TO=you@gmail.com
ALERT_EMAIL_FROM=             # defaults to SMTP_USER
